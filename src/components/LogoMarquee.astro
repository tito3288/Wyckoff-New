---
import type { LogoItem } from "../data/logos";

export interface ExternalCta {
  label: string;
  href: string;
}

interface Props {
  visibleLabel: string;
  accessibleLabel: string;
  logos: readonly LogoItem[];
  externalCta?: ExternalCta;
  id?: string;
}

const { visibleLabel, accessibleLabel, logos, externalCta, id } = Astro.props;
const sectionId = id ?? visibleLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const headingId = `${sectionId}-heading`;
---
<section class="logo-marquee" id={sectionId} aria-labelledby={headingId}>
  <div class="wrap logo-marquee__header">
    <h2 class="label" id={headingId}>{visibleLabel}</h2>
    {externalCta && (
      <a class="textlink logo-marquee__cta" href={externalCta.href} target="_blank" rel="noopener noreferrer">
        {externalCta.label}<span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
  <div class="mq mq--logos" aria-label={accessibleLabel}>
    <div class="mq__track">
      {logos.map((logo) => (
        <img
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
    <div class="mq__track" aria-hidden="true">
      {logos.map((logo) => (
        <img
          src={logo.src}
          alt=""
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .logo-marquee__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2rem, 5vh, 3.5rem);
  }

  .logo-marquee__header .label {
    margin: 0;
  }

  .logo-marquee__cta {
    flex: none;
  }

  @media (max-width: 680px) {
    .logo-marquee__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
