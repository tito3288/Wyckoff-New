---
import type { LogoItem } from "../data/logos";
import ExternalArrow from "./ExternalArrow.astro";

export interface ExternalCta {
  label: string;
  href: string;
}

export interface FeatureImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  visibleLabel: string;
  accessibleLabel: string;
  logos: readonly LogoItem[];
  externalCta?: ExternalCta;
  featureImage?: FeatureImage;
  id?: string;
}

const { visibleLabel, accessibleLabel, logos, externalCta, featureImage, id } = Astro.props;
const sectionId = id ?? visibleLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const headingId = `${sectionId}-heading`;
---
<section class="logo-marquee" id={sectionId} aria-labelledby={headingId}>
  <div class:list={["wrap", "logo-marquee__header", externalCta && "logo-marquee__header--with-cta"]}>
    <h2 class="label" id={headingId}>{visibleLabel}</h2>
    {externalCta && (
      <a class="textlink logo-marquee__cta" href={externalCta.href} target="_blank" rel="noopener noreferrer">
        {externalCta.label}<ExternalArrow /><span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
  </div>
  {featureImage && (
    <div class="wrap logo-marquee__feature">
      <img
        src={featureImage.src}
        alt={featureImage.alt}
        width={featureImage.width}
        height={featureImage.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="mq mq--logos" aria-label={accessibleLabel}>
    <div class="mq__track">
      {logos.map((logo) => (
        <img
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
    <div class="mq__track" aria-hidden="true">
      {logos.map((logo) => (
        <img
          src={logo.src}
          alt=""
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .logo-marquee__header {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(2rem, 5vh, 3.5rem);
  }

  .logo-marquee__header--with-cta {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .logo-marquee__header .label {
    margin: 0;
    display: flex;
    align-items: center;
    gap: clamp(.75rem, 1.5vw, 1.1rem);
    color: var(--ink);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.2;
  }

  .logo-marquee__header .label::before {
    content: "";
    width: clamp(2rem, 3.5vw, 3.5rem);
    height: 2px;
    flex: none;
    background: var(--amber);
  }

  .logo-marquee__cta {
    grid-column: 2;
    justify-self: center;
    justify-content: center;
    max-width: 100%;
    text-align: center;
    white-space: normal;
  }

  .logo-marquee__feature {
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .logo-marquee__feature img {
    width: min(100%, 58rem);
    height: auto;
    margin-inline: auto;
    border-left: 3px solid var(--amber);
  }

  @media (max-width: 900px) {
    .logo-marquee__header--with-cta {
      grid-template-columns: 1fr;
    }

    .logo-marquee__cta {
      grid-column: 1;
      justify-self: center;
      text-align: center;
    }
  }
</style>
