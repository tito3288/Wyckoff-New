---
import BrandLogo from "./BrandLogo.astro";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const onHome = pathname === "/";
const links = [
  { href: onHome ? "#points" : "/#points", label: "Inflection Points", current: false },
  { href: "/about", label: "About", current: pathname === "/about" },
  { href: onHome ? "#insights" : "/#insights", label: "Insights", current: false },
  { href: onHome ? "#contact" : "/#contact", label: "Contact", current: false },
];
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <a class="foot__brand" href={onHome ? "#top" : "/"} aria-label="Wyckoff Consulting, home">
        <BrandLogo variant="lockup" class="foot__logo" />
      </a>
      <nav class="foot__nav" aria-label="Footer">
        {links.map((link) => <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>)}
      </nav>
    </div>
    <div class="foot__bar"><span>Strategy. Growth. Enterprise Value.</span><span>&copy; {year} Wyckoff Consulting</span></div>
  </div>
</footer>
