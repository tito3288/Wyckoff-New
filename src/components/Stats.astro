---
const stats = [
  { count: 33, suffix: "", label: "Years in practice" },
  { count: 20, suffix: "+", label: "Vertical markets" },
  { count: 12, suffix: "", label: "Countries" },
  { count: 100, suffix: "s", label: "Growth initiatives led" },
];
---
<section class="wrap band band--tan rv">
  <p class="label">Since 1993</p>
  <h2 class="display display--sm" style="max-width:17ch">Three decades of decisions, in rooms like yours.</h2>
  <div class="stats">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat__n" data-count={s.count} data-suffix={s.suffix || undefined}>0</span>
        <span class="stat__l">{s.label}</span>
      </div>
    ))}
  </div>
</section>
