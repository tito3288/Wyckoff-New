---
const posts = [
  {
    image: "/images/post-1.jpg",
    datetime: "2024-06",
    date: "June 2024",
    title: "Digital Strategies for EOS-Driven Companies",
  },
  {
    image: "/images/post-2.jpg",
    datetime: "2022-10",
    date: "October 2022",
    title: "Three Things to Do Before Google Multisearch Arrives",
  },
  {
    image: "/images/post-3.jpg",
    datetime: "2022-08",
    date: "August 2022",
    title: "Recessionary Times Are Redirecting the Great Resignation",
  },
];
---
<section class="wrap band rv" id="insights" style="padding-top:0">
  <p class="label">Insights</p>
  <h2 class="display display--sm" style="max-width:15ch">Wyckoff&rsquo;s Thought Leadership</h2>
  <div class="posts">
    {posts.map((post, index) => (
      <article class="post" aria-labelledby={`insight-title-${index}`}>
        <div class="post__img"><img src={post.image} alt="" loading="lazy" decoding="async" /></div>
        <time class="post__date" datetime={post.datetime}>{post.date}</time>
        <h3 id={`insight-title-${index}`}><span>{post.title}</span></h3>
      </article>
    ))}
  </div>
</section>
